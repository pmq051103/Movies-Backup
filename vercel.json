{
  "rewrites": [
    { "source": "/track", "destination": "/api/track" },
    { "source": "/stats", "destination": "/api/stats" },
    { "source": "/admin-login", "destination": "/api/adminLogin" },
    { "source": "/admin-me", "destination": "/api/adminMe" },
    { "source": "/admin-logout", "destination": "/api/adminLogout" },
    { "source": "/admin-maintenance", "destination": "/api/adminMaintenance" },
    { "source": "/admin-account", "destination": "/api/adminAccount" },
    { "source": "/api2/:path*", "destination": "https://vsmov.com/api/:path*" },
    { "source": "/api3/:path*", "destination": "https://ophim1.com/:path*" },
    { "source": "/api/:path*", "destination": "https://phimapi.com/:path*" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
