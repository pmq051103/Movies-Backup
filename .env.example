# ============================================================
# BIẾN MÔI TRƯỜNG (TÙY CHỌN)
# ------------------------------------------------------------
# Dự án chạy được NGAY mà KHÔNG cần file .env — tất cả giá trị
# dưới đây đã có fallback mặc định trong src/constants/index.ts.
#
# Chỉ tạo file .env (copy từ file này) nếu bạn muốn ghi đè
# API hoặc CDN ảnh mà không phải sửa code.
#
# Cách dùng:  cp .env.example .env
# ============================================================

# Base URL của API phim (mặc định: https://vsmov.com/api)
VITE_API_BASE_URL=https://vsmov.com/api

# Base URL của CDN ảnh poster/thumbnail (mặc định: https://vsmov.com/storage/images)
VITE_IMAGE_BASE_URL=https://vsmov.com/storage/images

# ============================================================
# QUẢN TRỊ + THỐNG KÊ (SUPABASE)
# ------------------------------------------------------------
# Tạo project miễn phí tại https://supabase.com/ → New project.
# Sau đó mở Dashboard → SQL Editor → paste nội dung file
# supabase/schema.sql → Run để tạo bảng + functions.
#
# TẠO TÀI KHOẢN ADMIN ĐẦU TIÊN (trong SQL Editor):
#   select public.create_admin_user('admin', 'matkhau-cua-ban', 'Admin');
# Rồi đăng nhập tại /admin trên production.
#
# Lấy các giá trị tại: Dashboard → Project Settings → API
#   - SUPABASE_URL = "Project URL"
#   - SUPABASE_SERVICE_ROLE_KEY = "service_role" (secret — chỉ khai
#     báo trong Vercel Settings, KHÔNG để lộ cho client)
# Khai báo trong Vercel: Project → Settings → Environment Variables.
# ============================================================
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Mật khẩu tài khoản admin MẶC ĐỊNH dùng trong môi trường dev/preview
# khi CHƯA có SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY (mock in-memory).
# Tài khoản mock: username `admin`, password = giá trị biến này.
# Trên production (có Supabase), biến này KHÔNG được dùng.
VITE_ADMIN_PASSWORD=admin123
VITE_TMDB_API_KEY=a88b822d9aa1cd0d7669a8263cb08b65